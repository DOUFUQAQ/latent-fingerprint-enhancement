# 本仓库不含任何硬编码凭据。这里只登记运行期真正会被读取的环境变量。
# 复制为 .env 后按需填写（.env 已被 .gitignore 忽略）。
#
# 数据路径与超参数通过命令行参数或源码顶部的常量传入；只有下面几项读环境变量。

# 选择用于推理的 GPU；scripts/process_sd04_dataset.py 会主动写入该变量。
# 留空或设为 -1 表示只用 CPU。
CUDA_VISIBLE_DEVICES=0

# ---- evaluation/run_cmc_evaluation*.py 与 evaluation/test_cmc_system.py ----
# 含 original/ 子目录的数据集根目录
LATENTFP_DATASET_DIR=datasets/processed_sd04_dataset
# 各对比方法的增强结果目录（本仓库不包含这些第三方方法的代码）
LATENTFP_PROPOSED_DIR=datasets/proposed
LATENTFP_GABOR_DIR=datasets/gabor
LATENTFP_STFT_DIR=datasets/stft
